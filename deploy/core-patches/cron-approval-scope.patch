+@contextmanager
+def cron_approval_scope(mode: str):
+    """Let trusted execution middleware bind policy without changing other runs."""
+    if mode not in {"approve", "deny"}:
+        raise ValueError("cron approval mode must be approve or deny")
+    token = _cron_approval_mode.set(mode)
+    try:
+        yield
+    finally:
+        _cron_approval_mode.reset(token)
+
