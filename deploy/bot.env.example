# 复制到受保护状态目录，命名为 bot.env，再填写。不要把填好的文件放进代码仓库。
# 模型密钥不写在这里。模型用官方自带的空白模板，放到状态目录的 data/config.yaml。

# 开放平台上这个机器人的应用编号和密钥。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 国际版 Lark 填 lark，国内飞书填 feishu。
FEISHU_DOMAIN=lark

# 云服务器用长连接，不需要开放入站端口。
FEISHU_CONNECTION_MODE=websocket

# 团队群聊允许同事进入，再由 lark-access 自动登记并限制管理权限。
# 管理员写在 data/lark-access/config.json；不要用接入名单代替管理员名单。
FEISHU_ALLOWED_USERS=
FEISHU_ALLOW_ALL_USERS=
FEISHU_GROUP_POLICY=open

# 可选。留空即可。
FEISHU_HOME_CHANNEL=
